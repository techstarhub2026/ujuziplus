# Database (Aiven for MySQL — SSL required)
# connection_limit is kept low because Vercel runs each request on a serverless
# instance — many concurrent instances each opening a pool would exhaust Aiven's
# free-tier connection cap fast. Raise it only if you move off serverless hosting.
#
# Aiven's cert is signed by their own project CA, not a public one, so Prisma
# needs it explicitly via sslcert=<path>. Locally, point sslcert straight at
# certs/aiven-ca.pem using an absolute path (relative paths don't resolve
# reliably for Prisma's query engine — Prisma CLI commands like `migrate deploy`
# read this var directly, bypassing src/lib/db.ts).
DATABASE_URL="mysql://user:password@your-service.aivencloud.com:PORT/defaultdb?sslaccept=strict&sslcert=/absolute/path/to/certs/aiven-ca.pem&connection_limit=5"

# On Vercel: leave sslcert out of DATABASE_URL above (its filesystem won't
# reliably have certs/aiven-ca.pem at a predictable path) and instead set this
# to the full contents of certs/aiven-ca.pem. src/lib/db.ts writes it to a temp
# file at runtime and appends sslcert automatically — only the app runtime
# picks this up, not the Prisma CLI.
DATABASE_CA_CERT=

# DATABASE_URL=:"mysql://root:robot10394.@localhost:3306/ujuzilab"

# Auth (required)
NEXTAUTH_SECRET="generate-a-long-random-string"
NEXTAUTH_URL="https://ujuziplus.co.tz"

# Backblaze B2 (file uploads — Vercel's filesystem is read-only, so uploads
# go to object storage instead of public/uploads)
# Create a bucket at backblaze.com/b2 and leave it Private (Public buckets
# require a card on file; Private doesn't). Files are served through
# /api/files/[...path], which redirects to a short-lived signed URL, so a
# public bucket URL is never needed.
# Create an App Key scoped to the bucket under Account → App Keys.
# B2_ENDPOINT is the S3-compatible endpoint shown on the bucket's page,
# e.g. https://s3.us-west-004.backblazeb2.com
B2_ENDPOINT=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=

# ClickPesa Payment Gateway (https://merchant.clickpesa.com → Settings → Developers)
# Create an application, generate an API key (shown once — copy immediately!)
CLICKPESA_CLIENT_ID=
CLICKPESA_API_KEY=

# Webhook secret — set this in the ClickPesa dashboard under webhook settings
# Used to verify the HMAC-SHA256 checksum on incoming webhook payloads
CLICKPESA_WEBHOOK_SECRET=

# Email (optional — logs to console when unset)
GMAIL_USER=
GMAIL_APP_PASSWORD=
CONTACT_INBOX=hello@ujuziplus.co.tz

# VAPID keys for Web Push notifications
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:hello@ujuziplus.co.tz"

# Shared secret for scheduled/cron API routes (mentor-reminders, heartbeat)
# Generate with: openssl rand -hex 32
CRON_SECRET=